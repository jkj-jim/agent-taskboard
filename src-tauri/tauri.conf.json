{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Taskboard",
  "version": "0.1.3",
  "identifier": "io.github.jkj-jim.agenttaskboard",
  "build": {
    "frontendDist": "shell",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Taskboard",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server": "server",
      "../shared": "shared",
      "../cli": "cli",
      "../skills": "skills",
      "../inject": "inject",
      "../scripts/codex-injector.mjs": "scripts/codex-injector.mjs",
      "../scripts/codex-injector-runtime.mjs": "scripts/codex-injector-runtime.mjs",
      "../scripts/codex-rate-limits.mjs": "scripts/codex-rate-limits.mjs",
      "../dist/web": "dist/web"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
