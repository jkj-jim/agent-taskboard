{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Taskboard",
  "version": "0.1.1",
  "identifier": "io.github.jkj-jim.agenttaskboard",
  "build": {
    "frontendDist": "shell"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../server": "server",
      "../shared": "shared",
      "../cli": "cli",
      "../skills": "skills",
      "../dist/web": "dist/web"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
